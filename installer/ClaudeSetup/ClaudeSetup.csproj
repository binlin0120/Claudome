<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Claudome</AssemblyName>
    <Title>Claudome</Title>
    <Product>Claudome</Product>
    <Description>Claude 独立环境部署助手</Description>
    <Authors>李诗恩;林琛</Authors>
    <Version>0.4.7</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Brand\Claudome.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Claudome.Core\Claudome.Core.csproj" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\artifacts\ClaudomeGuestNetwork.exe" LogicalName="ClaudeSetup.Guest.ClaudomeGuestNetwork.exe" />
    <EmbeddedResource Include="$(NuGetPackageRoot)yamldotnet/18.1.0/lib/netstandard2.0/YamlDotNet.dll" LogicalName="ClaudeSetup.Guest.YamlDotNet.dll" />
    <Resource Include="Brand\Claudome.png" />
    <EmbeddedResource Include="..\artifacts\ClaudeNetworkGateway.exe" LogicalName="ClaudeSetup.Guest.ClaudeNetworkGateway.exe" />
    <EmbeddedResource Include="..\artifacts\Gateway-THIRD-PARTY-NOTICES.txt" LogicalName="ClaudeSetup.Gateway-THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
