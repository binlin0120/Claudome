<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Claudome.Mac</AssemblyName>
    <Title>Claudome</Title>
    <Product>Claudome</Product>
    <Description>Claude 独立环境部署助手 (macOS)</Description>
    <Authors>李诗恩;林琛</Authors>
    <Version>0.4.8</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Claudome.Core\Claudome.Core.csproj" />
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <AvaloniaResource Include="..\ClaudeSetup\Brand\Claudome.png" Link="Assets\Claudome.png" />
    <EmbeddedResource Include="..\ClaudeSetup\Resources\catalog.json" LogicalName="ClaudeSetup.Resources.catalog.json" />
    <EmbeddedResource Include="..\ClaudeSetup\Guest\*.ps1" LogicalName="ClaudeSetup.Guest.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(NuGetPackageRoot)yamldotnet/18.1.0/lib/netstandard2.0/YamlDotNet.dll" LogicalName="ClaudeSetup.Guest.YamlDotNet.dll" />
    <EmbeddedResource Include="..\artifacts\Gateway-THIRD-PARTY-NOTICES.txt" Condition="Exists('..\artifacts\Gateway-THIRD-PARTY-NOTICES.txt')" LogicalName="ClaudeSetup.Gateway-THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>
</Project>
