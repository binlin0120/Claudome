# Keep downloads, private configuration and runtime evidence outside the public source.
/downloads/
/runtime/
/private/
/reports/
/backups/
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.iso
*.vhd
*.vhdx
*.avhdx
*.msi
*.exe
*.msix
*.msixbundle
*.zip
__pycache__/

# V11 local runtime, never publish
runtime-private/
**/runtime-private/
*.dpapi
*.clixml
*.new

# Per-task code may contain local paths or configuration.
/work/*
!/work/README.md

# .NET installer build output
**/bin/
**/obj/
/installer/artifacts/
.vs/
